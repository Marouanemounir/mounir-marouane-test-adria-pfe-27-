# Export these variables in each PowerShell process; Spring does not automatically load .env.
# Generate a random secret; use the SAME MCP_AUTH_TOKEN in both servers and the agent.
MCP_AUTH_TOKEN=
# Protect /api/chat. Defaults to MCP_AUTH_TOKEN if omitted.
AGENT_AUTH_TOKEN=
ACCOUNT_MCP_URL=http://localhost:8081
TRANSACTION_MCP_URL=http://localhost:8082
SPRING_PROFILES_ACTIVE=llm
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com
EUREKA_URL=http://localhost:8761/eureka/
CONFIG_SERVER_URL=http://localhost:8888
